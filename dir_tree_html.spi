:< shared

:= self_test () : i32 = $'dtl_self_test::dtl_self_test(0i32)'

:== tree_options = { dir : string; html : string }

:= run (args : list string) : i32 =
    ?= (cli_args.parse_operands args : result tree_options cli_args.cli_error) ?|
    | Ok options => host_write options.html (page options.dir (readme_html options.dir))
    | Error error =>
        console.write_error_line (cli_args.cli_error_text error)
        2i32

:= main () : i32 =
    := args = env.command_line_arguments ()
    ? cli_args.has_switch "self-test" args ?> self_test () |: run args
