:| ^ entry =
    | End
    | File : string * string * i64 * entry
    | Folder : string * string * entry * entry

:| ^ child =
    | ChildEnd
    | Child : i32 * string * child

:! root = entry

:? bytes node : node -> i64
:? render node : node -> string

:= (++) (left : string) (right : string) : string = sm.concat left right
:= (<.) (left : char) (right : char) : bool = !!!!LT(left, right)

:= (~!\\) \* t u. ((args : t), (code : string)) : u =
    $'__spiral_emit_rust !args !code '

:= host_arg_count () : i32 =
    !\\((), $'"std::env::args().count() as i32"')

:= host_arg (i : i32) : string =
    !\\(i, $'"Rc::<str>::from(std::env::args().nth($0 as usize).unwrap_or_default())"')

:= host_listing (path : string) : string =
    !\\(path, $'"{ let mut out = String::new(); if let Ok(read) = std::fs::read_dir($0.as_ref()) { for entry in \
        read.flatten() { let Ok(kind) = entry.file_type() else { continue }; if kind.is_symlink() { continue }; let \
        child = entry.path(); let Some(name) = child.file_name() else { continue }; let name = \
        name.to_string_lossy(); if child.is_dir() { out.push(char::from(49)); } else if child.is_file() { \
        out.push(char::from(48)); } else { continue }; out.push(char::from(32)); \
        out.push_str(&name.len().to_string()); out.push(char::from(10)); out.push_str(&name); } } \
        Rc::<str>::from(out) }"')

:= host_file_len (path : string) : i64 =
    !\\(path, $'"std::fs::metadata($0.as_ref()).map(|meta| meta.len() as i64).unwrap_or(0)"')

:= host_join (left : string) (right : string) : string =
    !\\((left, right), $'"Rc::<str>::from(std::path::Path::new($0.as_ref()).join($1.as_ref()).display().to_string())"')

:= host_read_text (path : string) : string =
    !\\(path, $'"Rc::<str>::from(std::fs::read_to_string($0.as_ref()).map(|text| \
        text.lines().collect::<Vec<_>>().join(&char::from(10).to_string())).unwrap_or_default())"')

:= host_is_file (path : string) : bool =
    !\\(path, $'"std::path::Path::new($0.as_ref()).is_file()"')

:= host_write_file (path : string) (text : string) : i32 =
    !\\((path, text), $'"i32::from(std::fs::write($0.as_ref(), $1.as_ref().as_bytes()).is_err())"')

:= host_mkdir (path : string) : i32 =
    !\\(path, $'"i32::from(std::fs::create_dir_all($0.as_ref()).is_err())"')

:= host_temp () : string =
    !\\((), $'"Rc::<str>::from(std::env::temp_dir().display().to_string())"')

:= host_process_id () : i64 =
    !\\((), $'"std::process::id() as i64"')

:= host_unix_nanos () : i64 =
    !\\((), $'"std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos() as i64"')

:= digit (n : i64) : string =
    ? n =. 0i64 ?> "0"
    |? n =. 1i64 ?> "1"
    |? n =. 2i64 ?> "2"
    |? n =. 3i64 ?> "3"
    |? n =. 4i64 ?> "4"
    |? n =. 5i64 ?> "5"
    |? n =. 6i64 ?> "6"
    |? n =. 7i64 ?> "7"
    |? n =. 8i64 ?> "8"
    |? n =. 9i64 ?> "9"
    |: "0"

:~ ^ show_i64 (n : i64) : string =
    := ch = digit (n %. 10i64)
    := rest = n /. 10i64
    ? rest =. 0i64 ?> ch |: show_i64 rest ++ ch

:= pad2 (n : i64) : string =
    := text = show_i64 n
    ? n < 10i64 ?> "0" ++ text |: text

:= show_hundredths (n : i64) : string =
    show_i64 (n /. 100i64) ++ "." ++ pad2 (n %. 100i64)

:= scaled (bytes : i64) (scale : i64) : i64 =
    (bytes *. 100i64 +. (scale /. 2i64)) /. scale

:= size_label (bytes : i64) : string =
    ? bytes > 1048576i64 ?> show_hundredths (scaled bytes 1048576i64) ++ " MB"
    |? bytes > 1024i64 ?> show_hundredths (scaled bytes 1024i64) ++ " KB"
    |: show_hundredths (scaled bytes 1i64) ++ " B"

:= join_rel (parent : string) (name : string) : string =
    ? (sm.length parent : i32) =. 0i32 ?> name |: parent ++ "/" ++ name

:= digit_value ch : i32 =
    ? ch =. (sm.index "0" 0i32) ?> 0i32
    |? ch =. (sm.index "1" 0i32) ?> 1i32
    |? ch =. (sm.index "2" 0i32) ?> 2i32
    |? ch =. (sm.index "3" 0i32) ?> 3i32
    |? ch =. (sm.index "4" 0i32) ?> 4i32
    |? ch =. (sm.index "5" 0i32) ?> 5i32
    |? ch =. (sm.index "6" 0i32) ?> 6i32
    |? ch =. (sm.index "7" 0i32) ?> 7i32
    |? ch =. (sm.index "8" 0i32) ?> 8i32
    |? ch =. (sm.index "9" 0i32) ?> 9i32
    |: 0i32

:~ ^ find_nl (text : string) (at : i32) : i32 =
    ? at =. (sm.length text : i32) ?> at
    |? (sm.index text at) =. (sm.index "\n" 0i32) ?> at
    |: find_nl text (at +. 1i32)

:~ ^ parse_digits (text : string) (at : i32) (stop : i32) (acc : i32) : i32 =
    ? at =. stop ?> acc
    |: parse_digits text (at +. 1i32) stop (acc *. 10i32 +. digit_value (sm.index text at))

:~ ^ parse (listing : string) (at : i32) : child =
    ? at =. (sm.length listing : i32) ?> ChildEnd
    |:
        := nl_at = find_nl listing (at +. 2i32)
        := nbytes = parse_digits listing (at +. 2i32) nl_at 0i32
        := name_from = nl_at +. 1i32
        := name = sm.slice listing { from = name_from; to = name_from +. nbytes -. 1i32 }
        := flag = ? (sm.index listing at) =. (sm.index "1" 0i32) ?> 1i32 |: 0i32
        Child (flag, name, parse listing (name_from +. nbytes))

:~ ^ cmp_at (left : string) (right : string) (at : i32) : i32 =
    := left_len = sm.length left : i32
    := right_len = sm.length right : i32
    ? at =. left_len && at =. right_len ?> 0i32
    |? at =. left_len ?> -1i32
    |? at =. right_len ?> 1i32
    |:
        := left_ch = sm.index left at
        := right_ch = sm.index right at
        ? left_ch =. right_ch ?> cmp_at left right (at +. 1i32)
        |? left_ch <. right_ch ?> -1i32
        |: 1i32

:= name_before (left : string) (right : string) : bool =
    (cmp_at left right 0i32) < 0i32

:= child_before (left_dir : i32) (left_name : string) (right_dir : i32) (right_name : string) : bool =
    ? left_dir =. right_dir ?> name_before left_name right_name |: left_dir > right_dir

:~ ^ insert (is_dir : i32) (name : string) (rest : child) : child =
    ?= rest ?|
    | ChildEnd => Child (is_dir, name, ChildEnd)
    | Child (other_dir, other_name, more) =>
        ? child_before is_dir name other_dir other_name ?> Child (is_dir, name, rest)
        |: Child (other_dir, other_name, insert is_dir name more)

:~ ^ sort (items : child) : child =
    ?= items ?|
    | ChildEnd => ChildEnd
    | Child (is_dir, name, more) => insert is_dir name (sort more)

:= anchor (icon : string) (href : string) (text : string) (size : i64) : string =
    := q = "\""
    icon ++ " <a href=" ++ q ++ href ++ q ++ ">" ++ text ++ "</a><span> (" ++ size_label size ++ ")</span>"

:~ ^ folder_bytes (item : entry) : i64 =
    ?= item ?|
    | End => 0i64
    | File (_, _, size, next) => size +. folder_bytes next
    | Folder (_, _, children, next) => folder_bytes children +. folder_bytes next

:+ bytes entry = \ item => folder_bytes item
:+ bytes root = \ (root items) => bytes items

:~ ^ html_chain (item : entry) : string =
    ?= item ?|
    | End => ""
    | File (name, parent, size, next) =>
        "<div>" ++ anchor "&#128196;" (join_rel parent name) name size ++ "</div>" ++ html_chain next
    | Folder (name, rel, children, next) =>
        := q = "\""
        "<details open=" ++ q ++ "true" ++ q ++ "><summary>" ++ anchor "&#128194;" rel name (bytes children) ++ "</summary><div>" ++ html_chain children ++ "</div></details>" ++ html_chain next

inl doc_head () : string = """
    <!DOCTYPE html>
    <html lang="en">
    <head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1">
      <style>
    html {
      -webkit-text-size-adjust: 100%;
      text-size-adjust: 100%;
    }
    body {
        background-color: #222;
        color: #ccc;
        margin: 8px;
        line-height: 1.6;
        overflow-wrap: anywhere;
    }
    a {
      color: #777;
      font-size: 15px;
    }
    span {
      font-size: 11px;
    }
    div > div {
      padding-left: 10px;
    }
    details > div {
      padding-left: 19px;
    }
    .readme {
      border-top: 1px solid #444;
      margin-top: 16px;
      padding-top: 8px;
      max-width: 900px;
    }
    .readme a {
      color: #9ab;
    }
    .readme pre {
      background-color: #1a1a1a;
      padding: 8px;
      overflow-x: auto;
    }
    @media (max-width: 600px) {
      a {
        font-size: 16px;
      }
      span {
        font-size: 12px;
      }
      div > div {
        padding-left: 4px;
      }
      details > div {
        padding-left: 10px;
      }
    }
      </style>
    </head>
    <body>
      <div>
    """
:= doc_close (readme : string) : string = "</div>\n" ++ readme ++ "</body>\n</html>\n"

:= copied_run (text : string) (run_start : i32) (stop : i32) : string =
    ? run_start =. stop ?> "" |: sm.slice text { from = run_start; to = stop -. 1i32 }

:~ ^ escape_from (text : string) (i : i32) (run_start : i32) (acc : string) : string =
    ? i =. (sm.length text : i32) ?> acc ++ copied_run text run_start i
    |:
        := ch = sm.index text i
        := entity =
            ? ch =. (sm.index "&" 0i32) ?> "&amp;"
            |? ch =. (sm.index "<" 0i32) ?> "&lt;"
            |? ch =. (sm.index ">" 0i32) ?> "&gt;"
            |? ch =. (sm.index "\"" 0i32) ?> "&quot;"
            |: ""
        ? entity =. "" ?> escape_from text (i +. 1i32) run_start acc
        |: escape_from text (i +. 1i32) (i +. 1i32) (acc ++ copied_run text run_start i ++ entity)

:= escape (text : string) : string = escape_from text 0i32 0i32 ""

:~ ^ find_char_from (text : string) (ch : char) (i : i32) : i32 =
    ? i =. (sm.length text : i32) ?> -1i32
    |? (sm.index text i) =. ch ?> i
    |: find_char_from text ch (i +. 1i32)

:~ ^ next_inline_marker_from (text : string) (i : i32) : i32 =
    ? i =. (sm.length text : i32) ?> i
    |? (sm.index text i) =. (sm.index "`" 0i32) ?> i
    |? (sm.index text i) =. (sm.index "[" 0i32) ?> i
    |? (sm.index text i) =. (sm.index "!" 0i32) ?> i
    |? (sm.index text i) =. (sm.index "*" 0i32) ?> i
    |? (sm.index text i) =. (sm.index "<" 0i32) ?> i
    |? (sm.index text i) =. (sm.index "\\" 0i32) ?> i
    |: next_inline_marker_from text (i +. 1i32)

:~ ^ double_close (text : string) (i : i32) : i32 =
    := n = sm.length text : i32
    ? i =. n ?> -1i32
    |? (i +. 1i32) =. n ?> -1i32
    |? (sm.index text i) =. (sm.index "*" 0i32) ?>
        ? (sm.index text (i +. 1i32)) =. (sm.index "*" 0i32) ?> i |: double_close text (i +. 1i32)
    |: double_close text (i +. 1i32)

:= escapable (ch : char) : bool =
    ? ch =. (sm.index "*" 0i32) ?> !+
    |? ch =. (sm.index "_" 0i32) ?> !+
    |? ch =. (sm.index "\\" 0i32) ?> !+
    |? ch =. (sm.index "`" 0i32) ?> !+
    |? ch =. (sm.index "[" 0i32) ?> !+
    |? ch =. (sm.index "]" 0i32) ?> !+
    |? ch =. (sm.index "#" 0i32) ?> !+
    |? ch =. (sm.index "-" 0i32) ?> !+
    |? ch =. (sm.index "!" 0i32) ?> !+
    |? ch =. (sm.index "<" 0i32) ?> !+
    |: !-

:~ image_close (text : string) (i : i32) : i32 =
    := n = sm.length text : i32
    ? (sm.index text i) =. (sm.index "!" 0i32)
    ?>
        ? (i +. 1i32) =. n
        ?> -1i32
        |? (sm.index text (i +. 1i32)) =. (sm.index "[" 0i32)
        ?>
            := mid = find_char_from text (sm.index "]" 0i32) (i +. 2i32)
            ? mid =. -1i32
            ?> -1i32
            |? (mid +. 1i32) =. n
            ?> -1i32
            |? (sm.index text (mid +. 1i32)) =. (sm.index "(" 0i32)
            ?> find_char_from text (sm.index ")" 0i32) (mid +. 2i32)
            |: -1i32
        |: -1i32
    |: -1i32

:= render_image (text : string) (i : i32) (close : i32) : string =
    := mid = find_char_from text (sm.index "]" 0i32) (i +. 2i32)
    := q = "\""
    "<img src="
    ++ q
    ++ escape (copied_run text (mid +. 2i32) close)
    ++ q
    ++ " alt="
    ++ q
    ++ escape (copied_run text (i +. 2i32) mid)
    ++ q
    ++ ">"

:~ badge_close (text : string) (i : i32) : i32 =
    := n = sm.length text : i32
    ? (sm.index text i) =. (sm.index "[" 0i32)
    ?>
        ? (i +. 1i32) =. n
        ?> -1i32
        |:
            := inner = image_close text (i +. 1i32)
            ? inner =. -1i32
            ?> -1i32
            |? (inner +. 1i32) =. n
            ?> -1i32
            |? (sm.index text (inner +. 1i32)) =. (sm.index "]" 0i32)
            ?>
                ? (inner +. 2i32) =. n
                ?> -1i32
                |? (sm.index text (inner +. 2i32)) =. (sm.index "(" 0i32)
                ?> find_char_from text (sm.index ")" 0i32) (inner +. 3i32)
                |: -1i32
            |: -1i32
    |: -1i32

:~ ^ inline_from (text : string) (i : i32) (acc : string) : string =
    := n = sm.length text : i32
    ? i =. n
    ?> acc
    |:
        := ch = sm.index text i
        := plain () =
            := stop = next_inline_marker_from text (i +. 1i32)
            inline_from text stop (acc ++ escape (copied_run text i stop))
        ? ch =. (sm.index "`" 0i32)
        ?>
            := close = find_char_from text ch (i +. 1i32)
            ? close =. -1i32
            ?> plain ()
            |:
                inline_from text
                    (close +. 1i32)
                    (acc ++ "<code>" ++ escape (sm.slice text { from = i +. 1i32; to = close -. 1i32 }) ++ "</code>")
        |? ch =. (sm.index "\\" 0i32)
        ?>
            ? (i +. 1i32) =. n
            ?> plain ()
            |? escapable (sm.index text (i +. 1i32))
            ?> inline_from text (i +. 2i32) (acc ++ escape (copied_run text (i +. 1i32) (i +. 2i32)))
            |: plain ()
        |? ch =. (sm.index "*" 0i32)
        ?>
            ? (i +. 1i32) =. n
            ?> plain ()
            |? (sm.index text (i +. 1i32)) =. (sm.index "*" 0i32)
            ?>
                := close = double_close text (i +. 2i32)
                ? close =. -1i32
                ?> plain ()
                |:
                    inline_from text
                        (close +. 2i32)
                        (acc ++ "<strong>" ++ inline_from (copied_run text (i +. 2i32) close) 0i32 "" ++ "</strong>")
            |: plain ()
        |? ch =. (sm.index "<" 0i32)
        ?>
            := close = find_char_from text (sm.index ">" 0i32) (i +. 1i32)
            ? close =. -1i32
            ?> plain ()
            |? close > (i +. 5i32)
            ?>
                := url = copied_run text (i +. 1i32) close
                ? (copied_run url 0i32 4i32) =. "http"
                ?>
                    := q = "\""
                    inline_from text
                        (close +. 1i32)
                        (acc ++ "<a href=" ++ q ++ escape url ++ q ++ ">" ++ escape url ++ "</a>")
                |: plain ()
            |: plain ()
        |? ch =. (sm.index "!" 0i32)
        ?>
            := close = image_close text i
            ? close =. -1i32 ?> plain ()
            |: inline_from text (close +. 1i32) (acc ++ render_image text i close)
        |? (badge_close text i) =. -1i32
        ?>
            ? ch =. (sm.index "[" 0i32)
            ?>
                := mid = find_char_from text (sm.index "]" 0i32) (i +. 1i32)
                ? mid =. -1i32
                ?> plain ()
                |? (mid +. 1i32) =. n
                ?> plain ()
                |? (sm.index text (mid +. 1i32)) =. (sm.index "(" 0i32)
                ?>
                    := close = find_char_from text (sm.index ")" 0i32) (mid +. 2i32)
                    ? close =. -1i32
                    ?> plain ()
                    |:
                        := q = "\""
                        := label = sm.slice text { from = i +. 1i32; to = mid -. 1i32 }
                        := href = sm.slice text { from = mid +. 2i32; to = close -. 1i32 }
                        inline_from text
                            (close +. 1i32)
                            (acc ++ "<a href=" ++ q ++ escape href ++ q ++ ">" ++ escape label ++ "</a>")
                |: plain ()
            |: plain ()
        |:
            := close = badge_close text i
            := inner = image_close text (i +. 1i32)
            := q = "\""
            inline_from text
                (close +. 1i32)
                (
                    acc
                    ++ "<a href="
                    ++ q
                    ++ escape (copied_run text (inner +. 3i32) close)
                    ++ q
                    ++ ">"
                    ++ render_image text (i +. 1i32) inner
                    ++ "</a>"
                )

:= render_inline (text : string) : string = inline_from text 0i32 ""

:~ ^ starts_at (line : string) (prefix : string) (i : i32) : bool =
    ? i =. (sm.length prefix : i32) ?> !+
    |? i =. (sm.length line : i32) ?> !-
    |? (sm.index line i) =. (sm.index prefix i) ?> starts_at line prefix (i +. 1i32)
    |: !-

:= starts (line : string) (prefix : string) : bool = starts_at line prefix 0i32

:~ ^ blank_from (line : string) (i : i32) : bool =
    ? i =. (sm.length line : i32) ?> !+
    |? (sm.index line i) =. (sm.index " " 0i32) ?> blank_from line (i +. 1i32)
    |: !-

:~ ^ count_hashes (line : string) (i : i32) : i32 =
    ? i =. (sm.length line : i32) ?> i
    |? (sm.index line i) =. (sm.index "#" 0i32) ?> count_hashes line (i +. 1i32)
    |: i

:= heading_level (line : string) : i32 =
    := hashes = count_hashes line 0i32
    ? hashes =. 0i32 ?> 0i32
    |? hashes > 6i32 ?> 0i32
    |? hashes =. (sm.length line : i32) ?> 0i32
    |? (sm.index line hashes) =. (sm.index " " 0i32) ?> hashes
    |: 0i32

:~ ^ lead_spaces (line : string) (i : i32) : i32 =
    ? i =. (sm.length line : i32) ?> i
    |? (sm.index line i) =. (sm.index " " 0i32) ?> lead_spaces line (i +. 1i32)
    |: i

:= bullet_start (line : string) : i32 =
    := lead = lead_spaces line 0i32
    ? (lead +. 2i32) > (sm.length line : i32) ?> -1i32
    |? (sm.index line (lead +. 1i32)) =. (sm.index " " 0i32) ?>
        ? (sm.index line lead) =. (sm.index "-" 0i32) ?> lead +. 2i32
        |? (sm.index line lead) =. (sm.index "*" 0i32) ?> lead +. 2i32
        |: -1i32
    |: -1i32

:| md_block =
    | MdNone
    | MdParagraph
    | MdList
    | MdCode

:= close_block (block : md_block) : string =
    ?= block ?|
    | MdNone => ""
    | MdParagraph => "</p>\n"
    | MdList => "</ul>\n"
    | MdCode => "</code></pre>\n"

:~ ^ markdown_lines (text : string) (at : i32) (block : md_block) (acc : string) : string =
    := n = sm.length text : i32
    ? at > n
    ?> acc ++ close_block block
    |:
        := nl = find_nl text at
        := line = sm.slice text { from = at; to = nl -. 1i32 }
        := next = nl +. 1i32
        ?= block ?|
        | MdCode =>
            ? starts line "```" ?> markdown_lines text next MdNone (acc ++ "</code></pre>\n")
            |: markdown_lines text next MdCode (acc ++ escape line ++ "\n")
        | _ =>
            := level = heading_level line
            ? starts line "```"
            ?> markdown_lines text next MdCode (acc ++ close_block block ++ "<pre><code>")
            |? blank_from line 0i32
            ?> markdown_lines text next MdNone (acc ++ close_block block)
            |? level > 0i32
            ?>
                := tag =
                    ? level =. 1i32 ?> "h1"
                    |? level =. 2i32 ?> "h2"
                    |? level =. 3i32 ?> "h3"
                    |? level =. 4i32 ?> "h4"
                    |? level =. 5i32 ?> "h5"
                    |: "h6"
                := title = sm.slice line { from = level +. 1i32; to = (sm.length line : i32) -. 1i32 }
                markdown_lines text next MdNone (
                    acc ++ close_block block ++ "<" ++ tag ++ ">" ++ render_inline title ++ "</" ++ tag ++ ">\n"
                )
            |? line =. "---"
            ?> markdown_lines text next MdNone (acc ++ close_block block ++ "<hr>\n")
            |? (bullet_start line) > 0i32
            ?>
                := item =
                    "<li>" ++ render_inline (copied_run line (bullet_start line) (sm.length line : i32)) ++ "</li>\n"
                ?= block ?|
                | MdList => markdown_lines text next MdList (acc ++ item)
                | _ => markdown_lines text next MdList (acc ++ close_block block ++ "<ul>\n" ++ item)
            |:
                ?= block ?|
                | MdParagraph => markdown_lines text next MdParagraph (acc ++ " " ++ render_inline line)
                | _ => markdown_lines text next MdParagraph (acc ++ close_block block ++ "<p>" ++ render_inline line)

:= readme_html (dir : string) : string =
    := path = host_join dir "README.md"
    ? host_is_file path
    ?> "<section class=\"readme\">\n" ++ markdown_lines (host_read_text path) 0i32 MdNone "" ++ "</section>\n"
    |: ""

:+ render entry = \ item => html_chain item
:+ render root = \ (root items) => render items

:= page (tree : root) (readme : string) : string = doc_head () ++ render tree ++ doc_close readme

:~ ^ chain (path : string) (rel : string) (items : child) : entry =
    ?= items ?|
    | ChildEnd => End
    | Child (is_dir, name, more) =>
        := next = chain path rel more
        ? is_dir =. 1i32 ?>
            := child_path = host_join path name
            := child_rel = join_rel rel name
            := nested = chain child_path child_rel (sort (parse (host_listing child_path) 0i32))
            Folder (name, child_rel, nested, next)
        |:
            File (name, rel, host_file_len (host_join path name), next)

:= read_tree (dir : string) : root =
    root (chain dir "" (sort (parse (host_listing dir) 0i32)))

:~ ^ flag_at (name : string) (index : i32) (count : i32) : i32 =
    ? index =. count ?> -1i32
    |? (host_arg index) =. name ?> index
    |: flag_at name (index +. 1i32) count

:= argument (name : string) : i32 =
    := found = flag_at name 1i32 (host_arg_count ())
    ? found =. -1i32 ?> -1i32
    |? (found +. 1i32) < (host_arg_count ()) ?> found +. 1i32
    |: -1i32

:~ ^ last_sep (text : string) (at : i32) (found : i32) : i32 =
    ? at =. (sm.length text : i32) ?> found
    |:
        := ch = sm.index text at
        := next =
            ? ch =. (sm.index "/" 0i32) ?> at
            |? ch =. (sm.index "\\" 0i32) ?> at
            |: found
        last_sep text (at +. 1i32) next

:= parent_text (path : string) : string =
    := sep = last_sep path 0i32 -1i32
    ? sep =. -1i32 ?> ""
    |:
        := parent = sm.slice path { from = 0i32; to = sep -. 1i32 }
        ? (sm.length parent : i32) =. 2i32 && (sm.index parent 1i32) =. (sm.index ":" 0i32) ?>
            sm.slice path { from = 0i32; to = sep }
        |: parent

:= host_write (path : string) (text : string) : i32 =
    := parent = parent_text path
    := made = ? (sm.length parent : i32) =. 0i32 ?> 0i32 |: host_mkdir parent
    ? made =. 0i32 ?> host_write_file path text |: made

:~ ^ times (piece : string) (n : i64) : string =
    ? n <= 0i64 ?> "" |: piece ++ times piece (n -. 1i64)

:~ ^ lay (dir : string) (n : i64) : i32 =
    ? n < 0i64 ?> 0i32
    |:
        := _ = host_mkdir dir
        := mark = digit n
        := _ = host_write (host_join dir "file.txt") (times mark (n +. 1i64))
        lay (host_join dir mark) (n -. 1i64)

:= host_unique () : string =
    show_i64 (host_process_id ()) ++ "-" ++ show_i64 (host_unix_nanos ())

:= fresh () : string =
    host_join (host_temp ()) (host_unique ())

:= fixture () : string =
    := dir = fresh ()
    := _ = lay (host_join dir "_.root") 3i64
    dir

:= order_fixture () : string =
    := dir = fresh ()
    := _ = host_mkdir (host_join dir "m")
    := _ = host_write (host_join dir "b.txt") "x"
    := _ = host_write (host_join dir "a.txt") "yy"
    := _ = host_write (host_join (host_join dir "m") "file.txt") "z"
    dir

:= same (got : string) (want : string) (dump : string) : i32 =
    ? got =. want ?> 0i32
    |:
        := _ = host_write (host_join (host_temp ()) dump) got
        1i32

:= fixture_body () : string =
    "<details open=\"true\"><summary>&#128194; <a href=\"_.root\">_.root</a><span> (10.00 "
    ^^ "B)</span></summary><div><details open=\"true\"><summary>&#128194; <a href=\"_.root/3\">3</a><span> (6.00 "
    ^^ "B)</span></summary><div><details open=\"true\"><summary>&#128194; <a href=\"_.root/3/2\">2</a><span> (3.00 "
    ^^ "B)</span></summary><div><details open=\"true\"><summary>&#128194; <a href=\"_.root/3/2/1\">1</a><span> (1.00 "
    ^^ "B)</span></summary><div><div>&#128196; <a href=\"_.root/3/2/1/file.txt\">file.txt</a><span> (1.00 "
    ^^ "B)</span></div></div></details><div>&#128196; <a href=\"_.root/3/2/file.txt\">file.txt</a><span> (2.00 "
    ^^ "B)</span></div></div></details><div>&#128196; <a href=\"_.root/3/file.txt\">file.txt</a><span> (3.00 "
    ^^ "B)</span></div></div></details><div>&#128196; <a href=\"_.root/file.txt\">file.txt</a><span> (4.00 "
    ^^ "B)</span></div></div></details>"
:= order_body () : string =
    "<details open=\"true\"><summary>&#128194; <a href=\"m\">m</a><span> (1.00 "
    ^^ "B)</span></summary><div><div>&#128196; <a href=\"m/file.txt\">file.txt</a><span> (1.00 "
    ^^ "B)</span></div></div></details><div>&#128196; <a href=\"a.txt\">a.txt</a><span> (2.00 "
    ^^ "B)</span></div><div>&#128196; <a href=\"b.txt\">b.txt</a><span> (1.00 B)</span></div>"

:= readme_fixture () : string =
    := dir = fresh ()
    := _ = host_mkdir dir
    := _ =
        host_write
            (host_join dir "README.md")
            (
                "# Title\n\nSome `code` and [a link](x.html).\n\n- one\n- two <b>\n\n봉쥬르 & é [깃허브](k.html)\n\n"
                ^^ "Hi! ![logo](logo.png) [![CI](b.svg)](ci.html)\n\n**Bold** and <https://x.org> and \\*star\\*\n\n"
                ^^ "---\n\n- top\n  - nested\n\n```\nlet x = 1 < 2\n```\n"
            )
    dir

:= readme_body () : string =
    "<section class=\"readme\">\n<h1>Title</h1>\n<p>Some <code>code</code> and <a href=\"x.html\">a link</a>.</p>\n"
    ^^ "<ul>\n<li>one</li>\n<li>two &lt;b&gt;</li>\n</ul>\n<p>봉쥬르 &amp; é <a href=\"k.html\">깃허브</a></p>\n"
    ^^ "<p>Hi! <img src=\"logo.png\" alt=\"logo\"> <a href=\"ci.html\"><img src=\"b.svg\" alt=\"CI\"></a></p>\n"
    ^^ "<p><strong>Bold</strong> and <a href=\"https://x.org\">https://x.org</a> and *star*</p>\n<hr>\n<ul>\n"
    ^^ "<li>top</li>\n<li>nested</li>\n</ul>\n<pre><code>let x = 1 &lt; 2\n</code></pre>\n</section>\n"

:= self_test () : i32 =
    := tree = read_tree (fixture ())
    := page_ok = same (page tree "") (doc_head () ++ fixture_body () ++ doc_close "") "dir-tree-html-got.html"
    := total_ok = ? (bytes tree) =. 10i64 ?> 0i32 |: 3i32
    := order_ok =
        same
            (page (read_tree (order_fixture ())) "")
            (doc_head () ++ order_body () ++ doc_close "")
            "dir-tree-html-order-got.html"
    := readme_ok = same (readme_html (readme_fixture ())) (readme_body ()) "dir-tree-html-readme-got.html"
    := close_ok = same (doc_close "<p>r</p>\n") "</div>\n<p>r</p>\n</body>\n</html>\n" "dir-tree-html-close-got.html"
    := labels_ok =
        ? (size_label 1024i64) =. "1024.00 B" ?>
            ? (size_label 1025i64) =. "1.00 KB" ?>
                ? (size_label 1048576i64) =. "1024.00 KB" ?>
                    ? (size_label 1048577i64) =. "1.00 MB" ?> 0i32 |: 1i32
                |: 1i32
            |: 1i32
        |: 1i32
    ? page_ok =. 0i32
    ?>
        ? total_ok =. 0i32
        ?>
            ? order_ok =. 0i32
            ?>
                ? readme_ok =. 0i32
                ?>
                    ? close_ok =. 0i32
                    ?> labels_ok
                    |: 5i32
                |: 4i32
            |: order_ok
        |: total_ok
    |: page_ok

:= run () : i32 =
    := dir_at = argument "--dir"
    := html_at = argument "--html"
    ? dir_at =. -1i32 ?> 2i32
    |? html_at =. -1i32 ?> 2i32
    |: host_write (host_arg html_at) (page (read_tree (host_arg dir_at)) (readme_html (host_arg dir_at)))

:= main () : i32 =
    ? (host_arg_count ()) =. 2i32 ?>
        ? (host_arg 1i32) =. "--self-test" ?> self_test () |: run ()
    |: run ()
